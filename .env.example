# ==========================================================================
# AI学習コーチ塾 - 環境変数テンプレート
# 本番環境で .env ファイルにコピーして使用してください（.env は git 無視）
# ==========================================================================

# --- Anthropic API ---
# https://console.anthropic.com/ でAPIキー取得
ANTHROPIC_API_KEY=sk-ant-api-your-key-here

# --- Mathpix 手書き数式 OCR (任意・AIチューター写真解答の前処理) ---
# https://mathpix.com/ で Convert API キー発行。$0.002/req と安価。
# 両方未設定なら OCR 前処理はスキップされ、既存挙動のまま動作する（完全 opt-in）。
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# --- Wolfram|Alpha 検算 (任意・AI生成問題の誤答キー検出) ---
# https://developer.wolframalpha.com/ で LLM API の AppID 発行。非商用は 2,000 コール/月 無料 (PoC用)。
# ※本番(商用)で常用するなら Wolfram に商用見積もりが必要。未設定なら検算は完全スキップ。
# 対象: rikei の 記述式(short_answer) 数学/物理/化学 + 選択式(multiple_choice) の数学(正解選択肢を検算)。
# 保存時(バッチ自動生成/補充/burst-seed/手動 の全経路)。※ seed 取込は対象外。
# WOLFRAM_APP_ID 未設定なら検算は完全スキップ。枯渇時は自動で未検証フォールバック(暴走しない)。
WOLFRAM_APP_ID=
# "1" で検算 mismatch を保存ブロック(再生成)。既定 "0" = 助言のみ(誤検出で良問を捨てない安全側)。
WOLFRAM_VERIFY_BLOCK=0

# --- 語彙SRS スケジューラ ---
# "1" (既定) = FSRS-4.5 (少ない復習で同じ定着率)。"0" = 従来 Leitner 固定間隔へロールバック。
# box 列は常に併存更新するため、0 に戻すだけで無損失で Leitner へ戻せる。キー不要・費用ゼロ。
VOCAB_FSRS_ENABLED=1

# --- Stripe 決済 ---
# https://dashboard.stripe.com/apikeys でキー取得
STRIPE_SECRET_KEY=sk_live_your-key-here
STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-key-here

# Stripe商品のPrice ID（ダッシュボードで商品作成後）
STRIPE_PRICE_STANDARD=price_xxx
STRIPE_PRICE_PREMIUM=price_xxx
STRIPE_PRICE_FAMILY=price_xxx
STRIPE_PRICE_STUDENT_ADDON=price_xxx
STRIPE_PRICE_TRIAL=price_xxx
STRIPE_PRICE_ENROLLMENT=price_xxx

# 後方互換（旧プラン名）
STRIPE_PRICE_AI=price_xxx
STRIPE_PRICE_HYBRID=price_xxx
STRIPE_PRICE_INTENSIVE=price_xxx

# --- 認証（マジックリンク方式）---
# 32文字以上のランダム値を推奨。`python3 -c "import secrets; print(secrets.token_urlsafe(48))"` で生成可能
# 本番ではこの値が漏洩すると全ユーザーのセッション偽造が可能になるため厳重管理
MAGIC_LINK_SECRET=generate-a-random-48-char-string
# セッションの有効期限（秒）。既定 30日。短くしたい場合は 604800 (7日) 等
SESSION_TTL_SECONDS=2592000

# --- Resend (メール送信サービス) ---
# https://resend.com/api-keys で取得。月3000通まで無料
# 未設定時は開発モードとしてログイン URL をコンソール出力にフォールバック
RESEND_API_KEY=re_your_key_here
# 送信元。独自ドメインを Resend で verify すれば info@trillion-ai-juku.com などに変更可
FROM_EMAIL="AI学習コーチ塾 <onboarding@resend.dev>"

# --- LINE Messaging API（廃止予定・未使用）---
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=

# --- DB接続 (Railway Postgres) ---
# 本番の DATABASE_URL は Railway が自動注入するのでここには書かない。
# 以下はすべて既定値で運用でき、触るのは障害対応のときだけ。

# 接続プール。不具合を疑うときは DB_POOL_ENABLED を 0 → 再起動で「毎回つなぎ直す」旧方式に即戻せる。
# ★直ったら必ず 1 に戻すこと (戻し忘れると点検で警告が出続ける)。
DB_POOL_ENABLED=1
DB_POOL_MIN=2                  # 上限64
DB_POOL_MAX=16                 # 上限64
DB_POOL_TIMEOUT=10             # プールの空き待ち秒。上限120
# 接続確立の上限秒。★0 は libpq が「無限待ち」と解釈するので使わない (最低 2 に丸められる)。
DB_CONNECT_TIMEOUT=10          # 上限60

# 🔒 2026-09-03「本番API 75分全停止」の再発防止。通常は既定のまま触らない。
# トランザクションを開いたまま放置された接続を、Postgres 側で切るまでの秒数。
# デプロイでコンテナが消えても接続だけが Postgres に残り、テーブルを掴んだままになる
# 事故を自己修復させるための安全弁 (この事故は再デプロイでは直らなかった)。0 = 無効。
# ★短くしすぎ注意: 過去問PDFアップロードの Gemini 解析はタイムアウトが 300 秒ある。
#   現在は解析の前に commit を入れてあるのでこの経路は対象外だが、その commit を外すと
#   300 秒と真正面から衝突し「解析は成功したのに保存で落ちる」失敗に戻る。600 はその保険。
DB_IDLE_TX_TIMEOUT=600         # 上限86400

# 起動時のテーブル定義更新が、ロック待ち1回を諦めるまでの秒数。
# 0 (無効) にすると、テーブルを掴んだ接続が1本あるだけで起動が待たされ、
# healthcheck (120秒) に間に合わずデプロイが失敗し続ける。
DB_INIT_LOCK_TIMEOUT=10        # 上限300
# 起動時DDLにかける合計秒。ロック1回ごとの上限 (上) だけでは合計時間に蓋ができないため。
# ★計時はテーブル定義のまとめ実行から始まるが、**中断できるのは列追加ループの境界だけ**なので
#   「起動時DDLが必ずこの秒数で終わる」わけではない。起動全体の最悪時間は
#   server/railway.json の healthcheckTimeout(120) と必ずセットで見ること。
# 超えたぶんは諦めて起動を優先する (起動できないより被害が小さい)。0 = 無制限。
DB_INIT_DDL_BUDGET=20          # 上限600
# ★DB_IDLE_TX_TIMEOUT / DB_INIT_LOCK_TIMEOUT / DB_INIT_DDL_BUDGET をすべて 0 にしても
#   「ALTER の事前チェック」等は従来挙動に戻らない (コードの revert が必要)。
# ★諦めた更新は /api/health の init_ddl_skipped / init_ddl_hint に出る。
# ★既定値の正典は server/main.py の _env_int("DB_...") 行。食い違ったらコードが正しい。

# --- サイト基本設定 ---
BASE_URL=https://your-domain.com
