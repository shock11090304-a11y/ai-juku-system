{
  "rewrites": [
    {
      "source": "/payment/api/stripe-charges",
      "destination": "/api/stripe-charges"
    },
    {
      "source": "/payment/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/payment/api/mail-send",
      "destination": "/api/mail-send"
    },
    {
      "source": "/payment/api/register-subscribe",
      "destination": "/api/register-subscribe"
    },
    {
      "source": "/payment/api/stripe-webhook",
      "destination": "/api/stripe-webhook"
    },
    {
      "source": "/payment/api/past-due-invoice",
      "destination": "/api/past-due-invoice"
    },
    {
      "source": "/payment/api/registered-customers",
      "destination": "/api/registered-customers"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ai-juku-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/qr/:path*",
      "destination": "https://ai-juku-api-production.up.railway.app/qr/:path*"
    }
  ],
  "headers": [
    {
      "source": "/marketing-assets/:campaign/:file(.+\\.svg)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; sandbox" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
