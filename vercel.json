    {
      "source": "/api/:path*",
      "destination": "https://ai-juku-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/qr/:path*",
      "destination": "https://ai-juku-api-production.up.railway.app/qr/:path*"
    }
  ],
  "headers": [
    {
      "source": "/marketing-assets/:campaign/:file(.+\\.svg)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; sandbox" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/cache-purge.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/auth-guard.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
